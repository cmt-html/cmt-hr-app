// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String   @unique
  phone       String?
  address     String?
  branding    Json?    // { primaryColor: string, logo: string }
  status      String   @default("APPROVED") // PENDING, APPROVED, REJECTED, DISABLED
  
  subscription Json?   // { planId: string, status: string, trialEndsAt: date }
  
  settings    Json?    // { features: string[] }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  attendances Attendance[]
  leaves      Leave[]
  configs     WorkingConfig[]
  auditLogs   AuditLog[]
  
  // Extended Modules
  announcements Announcement[]
  tickets       Ticket[]
  goals         Goal[]
  reviews       PerformanceReview[]
  jobs          Job[]
  applicants    Applicant[]
  documents     Document[]
  timesheets    Timesheet[]
  customFields  CustomField[]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          String    @default("EMPLOYEE") // SUPER_ADMIN, ORG_ADMIN, MANAGER, EMPLOYEE, HR
  phone         String?
  designation   String?
  department    String?
  employeeId    String    @unique
  dateOfJoining DateTime
  emergencyContact     String?
  emergencyContactName String?
  profilePicture       String?
  salary               Float?     // Salary field - only visible to Admin/Manager
  customFieldsData     Json?      // JSON containing custom form fields (e.g. { tShirtSize: "L" })

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  managerId     String?
  manager       User?     @relation("ManagerToSubordinate", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subordinates  User[]    @relation("ManagerToSubordinate")
  attendances   Attendance[]
  leaves        Leave[]
  
  // Extended Modules
  ticketsRaised   Ticket[]            @relation("UserTickets")
  ticketsAssigned Ticket[]            @relation("AssignedTickets")
  goals           Goal[]
  reviewsReceived PerformanceReview[] @relation("RevieweeReviews")
  reviewsGiven    PerformanceReview[] @relation("ReviewerReviews")
  documents       Document[]
  timesheets      Timesheet[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Json     // { monthly: number, yearly: number }
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Attendance {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  checkIn     DateTime
  checkOut    DateTime?
  location    String?
  status      String   @default("PRESENT") // PRESENT, LATE, ABSENT
  date        DateTime @default(now())
}

model Leave {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type        String      // SICK, CASUAL, ANNUAL, MATERNITY, PATERNITY, WFH
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String      @default("PENDING") // PENDING, APPROVED, REJECTED
  appliedAt   DateTime    @default(now())
}

model WorkingConfig {
  id                String   @id @default(uuid())
  organizationId    String?  @unique
  organization      Organization? @relation(fields: [organizationId], references: [id])
  windowStart       String   @default("08:00 AM")
  windowEnd         String   @default("08:00 PM")
  requiredHours     Int      @default(9)
  minPresentMinutes Int      @default(500) // 8 hours 20 minutes
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  action         String
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())
}

// ==========================================
//           CMT HR EXTENSIONS
// ==========================================

model Announcement {
  id             String        @id @default(uuid())
  title          String
  content        String
  type           String        @default("GENERAL") // POLICY, CELEBRATION, EVENT, GENERAL
  authorName     String
  authorId       String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  likes          Json?         // String[] (user IDs who liked)
  comments       Json?         // { userId, userName, comment, createdAt }[]
  createdAt      DateTime      @default(now())
}

model Ticket {
  id             String        @id @default(uuid())
  title          String
  description    String
  category       String        // IT, HR, FINANCE, FACILITIES
  priority       String        @default("LOW") // LOW, MEDIUM, HIGH
  status         String        @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  userId         String
  user           User          @relation("UserTickets", fields: [userId], references: [id])
  assignedToId   String?
  assignedTo     User?         @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments       Json?         // { authorId, authorName, text, createdAt }[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Goal {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  title          String
  description    String?
  targetValue    Int           @default(100)
  currentValue   Int           @default(0)
  unit           String        @default("%")
  startDate      DateTime
  endDate        DateTime
  status         String        @default("PENDING") // PENDING, APPROVED, IN_PROGRESS, ACHIEVED
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PerformanceReview {
  id             String        @id @default(uuid())
  revieweeId     String
  reviewee       User          @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  reviewerId     String
  reviewer       User          @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  cycleName      String
  rating         Int           @default(3) // 1-5 scale
  comments       String?
  selfReview     String?
  status         String        @default("PENDING") // PENDING, SELF_COMPLETED, FINISHED
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Job {
  id             String        @id @default(uuid())
  title          String
  description    String
  department     String
  requirements   String
  salaryRange    String?
  status         String        @default("OPEN") // OPEN, CLOSED
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  applicants     Applicant[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Applicant {
  id               String        @id @default(uuid())
  jobId            String
  job              Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  resumeUrl        String?
  status           String        @default("NEW") // NEW, REVIEWED, INTERVIEWED, HIRED, REJECTED
  onboardingTasks  Json?         // { id, task, status: 'PENDING'|'DONE', assignee: 'IT'|'HR'|'FACILITIES' }[]
  offboardingTasks Json?         // { id, task, status: 'PENDING'|'DONE', assignee: 'IT'|'HR'|'FACILITIES' }[]
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Document {
  id             String        @id @default(uuid())
  name           String
  url            String
  type           String        // OFFER_LETTER, ID_PROOF, CONTRACT, OTHER
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
}

model Timesheet {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  project        String        // Project name
  date           DateTime
  hoursLogged    Float
  description    String?
  status         String        @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
}

model CustomField {
  id             String        @id @default(uuid())
  fieldName      String        // e.g. "tShirtSize"
  fieldLabel     String        // e.g. "T-Shirt Size"
  fieldType      String        // TEXT, NUMBER, SELECT
  options        String?       // comma-separated for SELECT
  isRequired     Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
}
